<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Restaurant.Desktop.Views.MainWindow"
        Title="Ресторан - меню та замовлення"
        Width="1320" Height="900" MinWidth="1060" MinHeight="760">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Ресторан" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="Меню, замовлення та облік продажів" Margin="0,3,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="#E3ECE5" CornerRadius="6" Padding="14,8"
              VerticalAlignment="Center">
        <TextBlock Text="{Binding SaveState}" Foreground="#315640" />
      </Border>
    </Grid>

    <TabControl Grid.Row="1" IsEnabled="{Binding IsIdle}">
      <TabItem Header="Меню">
        <Grid ColumnDefinitions="*,338" Margin="0,16,0,0">
          <Border Classes="card" Margin="0,0,16,0">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section" Text="Позиції меню" />
                <TextBlock Grid.Column="1" Classes="muted"
                           Text="{Binding MenuRows.Count, StringFormat='У списку: {0}'}" />
              </Grid>
              <StackPanel Grid.Row="1">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Classes="label" Text="Пошук за назвою" />
                    <TextBox Text="{Binding SearchText}" PlaceholderText="Наприклад, борщ"
                             AutomationProperties.Name="Пошук за назвою" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="label" Text="Категорія" />
                    <TextBox Text="{Binding CategoryFilter}" PlaceholderText="Усі категорії"
                             AutomationProperties.Name="Фільтр категорії" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                  <CheckBox Content="Ціна за спаданням" IsChecked="{Binding PriceDescending}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Застосувати" Command="{Binding FilterCommand}" />
                    <Button Classes="primary" Content="Нова позиція" Command="{Binding NewMenuCommand}" Margin="0,0,0,8" />
                  </StackPanel>
                </Grid>
              </StackPanel>
              <DataGrid x:Name="MenuTable" Grid.Row="2" ItemsSource="{Binding MenuRows}" SelectedItem="{Binding SelectedMenu}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*" MinWidth="130" />
                  <DataGridTextColumn Header="Категорія" Binding="{Binding Category}" Width="135" />
                  <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="70" />
                  <DataGridTextColumn Header="Ціна" Binding="{Binding Price, StringFormat='{}{0:0.00}'}" Width="75" />
                  <DataGridTextColumn Header="До сплати" Binding="{Binding FinalPrice, StringFormat='{}{0:0.00}'}" Width="105" />
                  <DataGridTextColumn Header="Вихід" Binding="{Binding Portion}" Width="75" />
                  <DataGridCheckBoxColumn Header="Доступно" Binding="{Binding IsAvailable}" Width="100" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Classes="section" Text="{Binding MenuEditorTitle}" />
              <ScrollViewer x:Name="MenuEditorScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Classes="label" Text="Тип позиції" />
                  <ComboBox ItemsSource="{Binding MenuEditor.Kinds}" SelectedItem="{Binding MenuEditor.Kind}"
                            AutomationProperties.Name="Тип позиції" />
                  <TextBlock Classes="label" Text="Назва" />
                  <TextBox x:Name="NameInput" Text="{Binding MenuEditor.Name}" AutomationProperties.Name="Назва позиції" />
                  <TextBlock Classes="label" Text="Категорія" />
                  <TextBox Text="{Binding MenuEditor.Category}" AutomationProperties.Name="Категорія позиції" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Classes="label" Text="Ціна, грн" />
                      <TextBox x:Name="PriceInput" Text="{Binding MenuEditor.Price}" AutomationProperties.Name="Базова ціна" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="label" Text="{Binding MenuEditor.PortionLabel}" />
                      <TextBox Text="{Binding MenuEditor.PortionSize}" AutomationProperties.Name="Вихід порції" />
                    </StackPanel>
                  </Grid>
                  <CheckBox Content="Доступна для замовлення" IsChecked="{Binding MenuEditor.IsAvailable}" Margin="0,0,0,16" />
                  <StackPanel x:Name="ComboFields" IsVisible="{Binding MenuEditor.IsCombo}">
                    <TextBlock Classes="label" Text="Знижка, %" />
                    <TextBox Text="{Binding MenuEditor.Discount}" AutomationProperties.Name="Знижка комбо" />
                    <TextBlock Classes="label" Text="Склад комбо" />
                    <TextBlock Classes="muted" Text="Виберіть щонайменше дві позиції." FontSize="12" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Components}" SelectedItems="{Binding MenuEditor.SelectedComponents}"
                             SelectionMode="Multiple" Height="156" AutomationProperties.Name="Складники комбо">
                      <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Classes="muted" Text="Ціна й вихід мають бути більшими за нуль." FontSize="12" Margin="0,0,0,12" />
                <WrapPanel>
                  <Button Classes="primary" Content="Зберегти" Command="{Binding SaveMenuCommand}" />
                  <Button Classes="danger" Content="Видалити" Command="{Binding DeleteMenuCommand}" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Замовлення">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section" Text="Замовлення залу" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding OrderRows.Count, StringFormat='У списку: {0}'}" />
              </Grid>
              <StackPanel Grid.Row="1">
                <TextBlock Classes="label" Text="Статус" />
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                          PlaceholderText="Усі статуси" AutomationProperties.Name="Фільтр статусу" />
                <WrapPanel Margin="0,0,0,12">
                  <CheckBox Content="За сумою" IsChecked="{Binding SortOrdersByTotal}" Margin="0,0,18,8" />
                  <CheckBox Content="За спаданням" IsChecked="{Binding OrdersDescending}" Margin="0,0,18,8" />
                  <Button Content="Застосувати" Command="{Binding FilterCommand}" />
                </WrapPanel>
              </StackPanel>
              <StackPanel Grid.Row="2">
                <TextBlock Classes="label" Text="Номер столу" />
                <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                  <TextBox Text="{Binding TableNumber}" AutomationProperties.Name="Номер столу" />
                  <WrapPanel Grid.Column="1">
                    <Button Classes="primary" Content="Нове замовлення" Command="{Binding NewOrderCommand}" />
                    <Button Content="Змінити стіл" Command="{Binding ChangeTableCommand}" />
                  </WrapPanel>
                </Grid>
              </StackPanel>
              <DataGrid x:Name="OrdersTable" Grid.Row="3" ItemsSource="{Binding OrderRows}" SelectedItem="{Binding SelectedOrder}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Стіл" Binding="{Binding Table}" Width="70" />
                  <DataGridTextColumn Header="Дата й час" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM HH:mm}'}" Width="*" />
                  <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="105" />
                  <DataGridTextColumn Header="Сума, грн" Binding="{Binding Total, StringFormat='{}{0:0.00}'}" Width="100" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section" Text="{Binding OrderHeading}" />
                <Button Grid.Column="1" Classes="danger" Content="Видалити" Command="{Binding DeleteOrderCommand}" />
              </Grid>
              <StackPanel Grid.Row="1" IsEnabled="{Binding CanEditOrder}">
                <TextBlock Classes="label" Text="Позиція меню" />
                <ComboBox ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding SelectedOrderItem}"
                          PlaceholderText="Виберіть страву, напій або комбо" AutomationProperties.Name="Позиція для замовлення">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="label" Text="Кількість, від 1 до 50" />
                <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                  <TextBox Text="{Binding Quantity}" AutomationProperties.Name="Кількість порцій" />
                  <WrapPanel Grid.Column="1">
                    <Button Classes="primary" Content="Додати" Command="{Binding AddLineCommand}" />
                    <Button Content="Змінити" Command="{Binding ChangeQuantityCommand}" />
                    <Button Content="Вилучити" Command="{Binding RemoveLineCommand}" />
                  </WrapPanel>
                </Grid>
              </StackPanel>
              <DataGrid x:Name="LinesTable" Grid.Row="2" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Позиція" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Ціна" Binding="{Binding UnitPrice, StringFormat='{}{0:0.00}'}" Width="80" />
                  <DataGridTextColumn Header="К-сть" Binding="{Binding Quantity}" Width="75" />
                  <DataGridTextColumn Header="Сума" Binding="{Binding Total, StringFormat='{}{0:0.00}'}" Width="85" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="{Binding OrderTotal}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Classes="label" Text="Наступний статус" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding NextStatus}"
                            AutomationProperties.Name="Наступний статус замовлення" />
                  <Button Grid.Column="1" Classes="primary" Content="Змінити статус" Command="{Binding ChangeStatusCommand}" />
                </Grid>
                <TextBlock Classes="muted" FontSize="12"
                           Text="Нове → Готується → Подано → Оплачено. Скасування можливе до подання." />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Файли та звіт">
        <Grid ColumnDefinitions="320,*" ColumnSpacing="16" Margin="0,16,0,0">
          <Border Classes="card">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="section" Text="Дані ресторану" />
                <TextBlock Classes="muted" Text="Меню та замовлення зберігаються разом у файлі JSON." Margin="0,0,0,20" />
                <TextBlock Classes="label" Text="Шлях до JSON" />
                <TextBox Text="{Binding JsonPath}" AutomationProperties.Name="Шлях до файлу JSON" />
                <WrapPanel>
                  <Button Classes="primary" Content="Зберегти JSON" Command="{Binding ExportCommand}" />
                  <Button Content="Імпортувати" Command="{Binding ImportCommand}" />
                </WrapPanel>
                <Border Height="1" Background="#DCE5DF" Margin="0,20" />
                <TextBlock Classes="section" Text="Перевірка навантаження" />
                <TextBlock Classes="muted" Text="Демонстраційне меню та 10 000 замовлень замінять поточні дані після підтвердження." Margin="0,0,0,16" />
                <Button Content="Створити тестові дані" Command="{Binding GenerateCommand}" />
                <Button Content="Порівняти час розрахунку" Command="{Binding BenchmarkCommand}" />
                <TextBlock Classes="muted" FontSize="12" Margin="0,8,0,0"
                           Text="Порівняння послідовного й паралельного розрахунку. Результат з’явиться внизу вікна." />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Classes="section" Text="Продажі за категоріями" />
                  <TextBlock Classes="muted" Text="Лише оплачені замовлення" />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Content="Сформувати звіт" Command="{Binding ReportCommand}" />
              </Grid>
              <Border Grid.Row="1" Background="#EDF4EF" CornerRadius="6" Padding="14" Margin="0,18">
                <TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
              </Border>
              <DataGrid x:Name="ReportTable" Grid.Row="2" ItemsSource="{Binding ReportRows}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Категорія" Binding="{Binding Category}" Width="*" />
                  <DataGridTextColumn Header="Продано порцій" Binding="{Binding Quantity}" Width="150" />
                  <DataGridTextColumn Header="Виторг, грн" Binding="{Binding Revenue, StringFormat='{}{0:0.00}'}" Width="140" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Row="3" Margin="0,20,0,0">
                <TextBlock Classes="label" Text="Шлях до звіту XML" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBox Text="{Binding XmlPath}" AutomationProperties.Name="Шлях до звіту XML" />
                  <Button Grid.Column="1" Content="Експортувати XML" Command="{Binding XmlCommand}" />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Classes="card" Margin="0,16,0,0" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,8" />
        <ProgressBar Grid.Row="1" Value="{Binding Progress}" Minimum="0" Maximum="100" Height="5"
                     Foreground="#245D48" AutomationProperties.Name="Перебіг операції" />
        <Button Grid.Column="1" Grid.RowSpan="2" Content="Скасувати операцію"
                Command="{Binding CancelCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
