<!-- ШІ: Codex – вікно застосунку. Змін студентом ще не зафіксовано. -->
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Restaurant.Desktop.Views.MainWindow" Title="Ресторан — меню та замовлення"
        Width="1280" Height="850" MinWidth="1000" MinHeight="700">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Меню та замовлення" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Облік позицій, замовлень і виторгу за категоріями" Foreground="#586574" Margin="0,4,0,0"/>
    </StackPanel>
    <TabControl Grid.Row="1" IsEnabled="{Binding IsIdle}">
      <TabItem Header="Меню">
        <Grid ColumnDefinitions="*,340" Margin="0,12,0,0">
          <Grid RowDefinitions="Auto,*" Margin="0,0,16,0">
            <StackPanel>
              <Grid ColumnDefinitions="*,*"><TextBox PlaceholderText="Пошук за назвою" Text="{Binding SearchText}" Margin="0,0,8,8"/>
                <TextBox Grid.Column="1" PlaceholderText="Категорія (порожньо — усі)" Text="{Binding CategoryFilter}"/></Grid>
              <WrapPanel><CheckBox Content="Ціна за спаданням" IsChecked="{Binding PriceDescending}" Margin="0,0,12,8"/>
                <Button Content="Застосувати" Command="{Binding FilterCommand}"/><Button Content="Нова позиція" Command="{Binding NewMenuCommand}"/></WrapPanel>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding MenuRows}" SelectedItem="{Binding SelectedMenu}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категорія" Binding="{Binding Category}"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Kind}"/>
                <DataGridTextColumn Header="Ціна" Binding="{Binding Price}"/>
                <DataGridTextColumn Header="Зі знижкою" Binding="{Binding FinalPrice}"/>
                <DataGridTextColumn Header="Вихід" Binding="{Binding Portion}"/>
                <DataGridCheckBoxColumn Header="Доступно" Binding="{Binding IsAvailable}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <Grid Grid.Column="1" RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0">
            <StackPanel>
              <TextBlock Text="Редагування позиції" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="Тип"/><ComboBox ItemsSource="{Binding MenuEditor.Kinds}" SelectedItem="{Binding MenuEditor.Kind}" HorizontalAlignment="Stretch"/>
              <TextBlock Text="Назва"/><TextBox x:Name="NameInput" Text="{Binding MenuEditor.Name}"/>
              <TextBlock Text="Категорія"/><TextBox Text="{Binding MenuEditor.Category}"/>
              <TextBlock Text="Базова ціна, грн"/><TextBox x:Name="PriceInput" Text="{Binding MenuEditor.Price}"/>
              <TextBlock Text="Вихід: г / мл / набори"/><TextBox Text="{Binding MenuEditor.PortionSize}"/>
              <CheckBox Content="Доступна для замовлення" IsChecked="{Binding MenuEditor.IsAvailable}" Margin="0,0,0,10"/>
              <TextBlock Text="Знижка комбо, %"/><TextBox Text="{Binding MenuEditor.Discount}"/>
              <TextBlock Text="Склад комбо (виберіть щонайменше 2)" TextWrapping="Wrap"/>
              <ListBox ItemsSource="{Binding Components}" SelectedItems="{Binding MenuEditor.SelectedComponents}" SelectionMode="Multiple" Height="130" Margin="0,5,0,10">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>
          <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="Зберегти позицію" Command="{Binding SaveMenuCommand}"/><Button Content="Видалити" Command="{Binding DeleteMenuCommand}"/></WrapPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Замовлення">
        <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
          <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,16,0">
            <WrapPanel><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="160"/>
              <CheckBox Content="За сумою" IsChecked="{Binding SortOrdersByTotal}" Margin="12,0"/>
              <CheckBox Content="За спаданням" IsChecked="{Binding OrdersDescending}" Margin="0,0,12,0"/>
              <Button Content="Фільтр" Command="{Binding FilterCommand}"/></WrapPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="Номер столу"/><TextBox Text="{Binding TableNumber}"/>
              <WrapPanel><Button Content="Нове замовлення" Command="{Binding NewOrderCommand}"/><Button Content="Змінити стіл" Command="{Binding ChangeTableCommand}"/><Button Content="Видалити" Command="{Binding DeleteOrderCommand}"/></WrapPanel></StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding OrderRows}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns><DataGridTextColumn Header="Стіл" Binding="{Binding Table}"/><DataGridTextColumn Header="Час" Binding="{Binding CreatedAt}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/><DataGridTextColumn Header="Сума, грн" Binding="{Binding Total}"/></DataGrid.Columns>
            </DataGrid>
          </Grid>
          <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <StackPanel>
              <TextBlock Text="Склад вибраного замовлення" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <ComboBox ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding SelectedOrderItem}" PlaceholderText="Позиція меню" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Кількість (1–50)"/><TextBox Text="{Binding Quantity}"/>
              <WrapPanel><Button Content="Додати" Command="{Binding AddLineCommand}"/><Button Content="Змінити кількість" Command="{Binding ChangeQuantityCommand}"/><Button Content="Вилучити" Command="{Binding RemoveLineCommand}"/></WrapPanel>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns><DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Ціна" Binding="{Binding UnitPrice}"/>
                <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Сума" Binding="{Binding Total}"/></DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Новий статус"/>
              <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding NextStatus}" HorizontalAlignment="Stretch"/>
              <Button Content="Змінити статус" Command="{Binding ChangeStatusCommand}"/>
              <TextBlock Text="Нове → Готується → Подано → Оплачено. Скасувати можна до подання." TextWrapping="Wrap" Foreground="#586574"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Файли та звіт">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,12,0,0">
          <StackPanel><TextBlock Text="Файл даних JSON"/><TextBox Text="{Binding JsonPath}"/>
            <WrapPanel><Button Content="Імпортувати JSON" Command="{Binding ImportCommand}"/><Button Content="Зберегти JSON" Command="{Binding ExportCommand}"/>
              <Button Content="Створити 10 000 тестових замовлень" Command="{Binding GenerateCommand}"/></WrapPanel></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="Звіт за оплаченими замовленнями" FontSize="18" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,10,0,0"><Button Content="Сформувати звіт" Command="{Binding ReportCommand}"/><Button Content="Порівняти час: 1 потік / паралельно" Command="{Binding BenchmarkCommand}"/></WrapPanel></StackPanel>
          <TextBlock Grid.Row="2" Text="{Binding ReportSummary}" Margin="0,4,0,12"/>
          <DataGrid Grid.Row="3" ItemsSource="{Binding ReportRows}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns><DataGridTextColumn Header="Категорія" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Продано порцій" Binding="{Binding Quantity}"/>
              <DataGridTextColumn Header="Виторг, грн" Binding="{Binding Revenue}"/></DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="Файл звіту XML"/><TextBox Text="{Binding XmlPath}"/><Button Content="Експортувати XML" Command="{Binding XmlCommand}"/></StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <Grid ColumnDefinitions="*,Auto"><ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Скасувати операцію" Command="{Binding CancelCommand}" Margin="12,0,0,0"/></Grid>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="36"/>
    </StackPanel>
  </Grid>
</Window>
